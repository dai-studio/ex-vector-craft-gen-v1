    <bpmn:subProcess id="task_t6jkstql" name="1. Project scaffold">
      <bpmn:incoming>flow_h9ga0dnt</bpmn:incoming>
      <bpmn:outgoing>flow_km7bsjlb</bpmn:outgoing>
      <bpmn:task id="task_hutiwgke" name="Scaffold Vite + TS project" dai:notes="package.json (type module, exact pinned versions, scripts dev/build:ts/build:css/build/serve/start), tsconfig.json (strict, noUncheckedIndexedAccess, bundler resolution), vite.config.ts (base &#39;./&#39;, es2022), index.html with HUD markup, src/style.css. npm install. Design refs: Rule_single_file, Rule_cdn, Build Toolchain." dai:agentStatus="done">
        <bpmn:outgoing>flow_li45c2x7</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="task_qpk1td6a" name="config.ts + events.ts" dai:notes="Tuning constants exported as const; typed EventTarget bus (BlockChanged, PointerLockChange). Design refs: Tuning constants, Events." dai:agentStatus="done">
        <bpmn:incoming>flow_li45c2x7</bpmn:incoming>
      </bpmn:task>
      <bpmn:sequenceFlow id="flow_li45c2x7" sourceRef="task_hutiwgke" targetRef="task_qpk1td6a" />
    </bpmn:subProcess>
    <bpmn:subProcess id="task_ixkua9j7" name="2. World">
      <bpmn:incoming>flow_km7bsjlb</bpmn:incoming>
      <bpmn:outgoing>flow_8mc88s44</bpmn:outgoing>
      <bpmn:task id="task_zq8l0zz8" name="Block registry + Chunk model" dai:notes="src/world/blocks.ts (10 block ids, tiles, transparent/solid/liquid flags) and chunk.ts (Uint8Array 16x64x16, index x+z*16+y*256)." dai:agentStatus="done">
        <bpmn:outgoing>flow_zvb30c7b</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="task_gvbkfp2h" name="Gradient texture atlas" dai:notes="32px tiles, subtle gradients only (no per-pixel noise), 2px padding, half-texel inset UVs, Linear filtering, no mipmaps, sRGB." dai:agentStatus="done">
        <bpmn:incoming>flow_zvb30c7b</bpmn:incoming>
        <bpmn:outgoing>flow_ohk70v6n</bpmn:outgoing>
      </bpmn:task>
      <bpmn:sequenceFlow id="flow_zvb30c7b" sourceRef="task_zq8l0zz8" targetRef="task_gvbkfp2h" />
      <bpmn:task id="task_0ml0ccty" name="Terrain generator" dai:notes="Seeded ImprovedNoise fBm heights, grass/sand/dirt/stone, water at &#60;= SEA_LEVEL, hashed trees not on sand/underwater." dai:agentStatus="done">
        <bpmn:incoming>flow_ohk70v6n</bpmn:incoming>
        <bpmn:outgoing>flow_fupwhgww</bpmn:outgoing>
      </bpmn:task>
      <bpmn:sequenceFlow id="flow_ohk70v6n" sourceRef="task_gvbkfp2h" targetRef="task_0ml0ccty" />
      <bpmn:task id="task_0mqaabio" name="Chunk mesher" dai:notes="Face culling across chunk borders; opaque / cut-out / water meshes; per-face shade in vertex colours; lowered water tops; water material DoubleSide, depthWrite false." dai:agentStatus="done">
        <bpmn:incoming>flow_fupwhgww</bpmn:incoming>
        <bpmn:outgoing>flow_a80e4gwj</bpmn:outgoing>
      </bpmn:task>
      <bpmn:sequenceFlow id="flow_fupwhgww" sourceRef="task_0ml0ccty" targetRef="task_0mqaabio" />
      <bpmn:task id="task_z74dknz0" name="Chunk manager" dai:notes="Map of chunks, nearest-first generation (1/frame), remesh budget (2/frame), unload beyond RENDER_DISTANCE, getBlock/setBlock, border neighbour dirtying, apply saved edits on generate." dai:agentStatus="done">
        <bpmn:incoming>flow_a80e4gwj</bpmn:incoming>
      </bpmn:task>
      <bpmn:sequenceFlow id="flow_a80e4gwj" sourceRef="task_0mqaabio" targetRef="task_z74dknz0" />
    </bpmn:subProcess>
    <bpmn:subProcess id="task_d7c77fm5" name="3. Engine &#38; Player">
      <bpmn:incoming>flow_8mc88s44</bpmn:incoming>
      <bpmn:outgoing>flow_4upkrz8t</bpmn:outgoing>
      <bpmn:task id="task_4nvy223t" name="Engine bootstrap + post-processing" dai:notes="Renderer, scene/sky/fog incl. underwater fog, camera, lights, EffectComposer with depth-texture distance-blur ShaderPass (12-tap Poisson), OutputPass, resize handling." dai:agentStatus="done">
        <bpmn:outgoing>flow_xt8koz2q</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="task_tpizh8m1" name="Input + PointerLockControls" dai:notes="Keys, mouse buttons, wheel, digits, F fly, F3 debug, F4 blur; pointer lock and PointerLockChange event." dai:agentStatus="done">
        <bpmn:incoming>flow_xt8koz2q</bpmn:incoming>
        <bpmn:outgoing>flow_o22ijj2u</bpmn:outgoing>
