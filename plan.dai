      <bpmn:task id="task_s1t2lpws" name="Physics &#38; collision" dai:notes="AABB 0.6x1.8x0.6, axis-by-axis resolve, sub-steps &#60;= 0.5 block, walking/swimming/flying modes." dai:agentStatus="done">
        <bpmn:incoming>flow_o22ijj2u</bpmn:incoming>
        <bpmn:outgoing>flow_23ky65vd</bpmn:outgoing>
      </bpmn:task>
      <bpmn:sequenceFlow id="flow_o22ijj2u" sourceRef="task_tpizh8m1" targetRef="task_s1t2lpws" />
      <bpmn:task id="task_c80odk17" name="Raycast + block interaction" dai:notes="Amanatides &#38; Woo DDA (passes air and water), selection box, break/place rules, emits BlockChanged." dai:agentStatus="done">
        <bpmn:incoming>flow_23ky65vd</bpmn:incoming>
      </bpmn:task>
      <bpmn:sequenceFlow id="flow_23ky65vd" sourceRef="task_s1t2lpws" targetRef="task_c80odk17" />
    </bpmn:subProcess>
