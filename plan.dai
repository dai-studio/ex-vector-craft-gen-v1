    <bpmn:extensionElements>
      <dai:workflowMeta description="Implementation plan for Vector Craft derived from design.dai: scaffold, world, engine &#38; player, HUD/persistence/loop, verification." version="0.1.0" docId="a974a227-5831-419d-96ad-aedccbaccc18" role="plan">
