    <bpmn:task id="task_ermaehtb" name="config.ts + events.ts" dai:notes="src/config.ts exports all tuning constants; src/events.ts is a typed EventTarget bus (BlockChanged, PointerLockChange)." dai:agentStatus="done" dai:planRef="task_qpk1td6a">
      <bpmn:incoming>flow_ir2f3uxm</bpmn:incoming>
