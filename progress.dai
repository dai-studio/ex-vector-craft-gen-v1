    <bpmn:task id="task_n84rhtpc" name="Scaffold Vite + TS project" dai:notes="Installed three 0.170.0, @types/three 0.170.0, vite 8.3.6, typescript 7.0.2 (all exact). Wrote package.json scripts, tsconfig.json, vite.config.ts, index.html (HUD markup), src/style.css." dai:agentStatus="done" dai:planRef="task_hutiwgke">
